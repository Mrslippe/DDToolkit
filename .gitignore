# 环境变量 / 凭证文件
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
.pytest_cache/

# 数据库文件（本地开发用，不应提交）
*.db

# IDE
.vscode/
.idea/

# 虚拟环境
venv/
.venv/

# 日志与本地临时产物（会话/调试现场，一律不入库）
logs/
*.log
# SQLite WAL 边车文件（主库已被 *.db 覆盖，这两个不会自动跟随）
*.db-wal
*.db-shm

# AI 编码工具目录（技能包 / 会话 / 依赖；与 .vscode / .idea 同类，不入库）
# 注：opencode.json（LSP 配置）仍保留在仓库，属项目级开发环境配置
.opencode/

# 自检 / 调试临时目录（scripts/dev_check.py、ui_probe.py 的现场，通过即删）
/_devcheck_tmp/
/_ui_probe_tmp/
# 单元测试用工作区临时目录（沙箱下系统 temp 不可写，见 test_services 首启标记用例）
/_test_tmp/
# 排查问题时的一次性脚本/现场目录（_tmp_xxx.py、_tmp_xxx/）
/_tmp_*

# Node / 前端
node_modules/
.npm-cache/

# 本地缓存（图片代理磁盘缓存，可随时重建）
static/img-cache/
# 头像缓存（本地下载产物，不进仓库；2026-09-03 起出库）
static/avatars/

# pytest 临时残留目录（服务端迁移/异常时在 frontend 下生成的权限锁定目录）
pytest-cache-files-*/

# 桌面端构建产物（PyInstaller / Tauri）
/dist/
/build/
*.spec
frontend/src-tauri/target/
frontend/src-tauri/binaries/
frontend/src-tauri/gen/
/dist-portable/
/dist-release/
# 非开源分发资产（商用/试用字体原始文件，替换为开源子集后仅本地备份）
frontend/src/assets/fonts/_nondistribute/
docs/design/**/_nondistribute/
# 本机专用启动脚本（内含个人数据目录路径，绝不入库）
scripts/backend-8000.bat
# 工具卸载残留备份（非本项目资产：DSH 安装器的 package.json / lock / 设置副本）
_dsh_uninstall_backup/
