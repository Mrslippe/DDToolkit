{
  "manifest_version": 3,
  "name": "DDToolkit 凭据同步",
  "version": "0.1.0",
  "description": "把浏览器里已登录的 B 站 / 微博 / 小红书 / 抖音 Cookie 一键同步到本机的 DDToolkit（只走 127.0.0.1）。",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.weibo.com/*",
    "https://*.xiaohongshu.com/*",
    "https://*.douyin.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DDToolkit 凭据同步"
  },
  "minimum_chrome_version": "116"
}
